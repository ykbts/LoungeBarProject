<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                      http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
  version="4.0">

  <display-name>Lounge Bar Application</display-name>

  <welcome-file-list>
    <welcome-file>jsp/index.jsp</welcome-file>
  </welcome-file-list>


    <servlet>
        <servlet-name>rest</servlet-name>
        <servlet-class>dei.unipd.it.servlets.RestDispatcherServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>dei.unipd.it.servlets.LoginServlet</servlet-class>
    </servlet>

<servlet>
    <servlet-name>HomeServlet</servlet-name>
    <servlet-class>dei.unipd.it.servlets.HomeServlet</servlet-class>
</servlet>

<servlet>
    <servlet-name>CreateOrderServlet</servlet-name>
    <servlet-class>dei.unipd.it.servlets.CreateOrderServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>HomeServlet</servlet-name>
    <url-pattern>/home</url-pattern>
</servlet-mapping>

<servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
</servlet-mapping>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/signup</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>dei.unipd.it.servlets.HomeServlet</servlet-class>
    </servlet>




    <servlet>
        <servlet-name>CreateSupplyServlet</servlet-name>
        <servlet-class>dei.unipd.it.servlets.CreateSupplyServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>SearchSupplyServlet</servlet-name>
        <servlet-class>dei.unipd.it.servlets.SearchSupplyServlet</servlet-class>
    </servlet>
<servlet-mapping>
        <servlet-name>CreateOrderServlet</servlet-name>
        <url-pattern>/create-order</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SearchWaiterShiftServlet</servlet-name>
        <servlet-class>dei.unipd.it.servlets.SearchWaiterShiftServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/signup</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>CreateSupplyServlet</servlet-name>
        <url-pattern>/supply/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>SearchSupplyServlet</servlet-name>
        <url-pattern>/supply/search</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>SearchWaiterShiftServlet</servlet-name>
        <url-pattern>/shift/search-by-waiter</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>rest</servlet-name>
        <url-pattern>/rest/*</url-pattern>
    </servlet-mapping>

    <resource-ref>
        <description>PostgreSQL Datasource</description>
        <res-ref-name>jdbc/bar</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>
</web-app>

